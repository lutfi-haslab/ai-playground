# ==========================================
# LLM Benchmark Framework - API Keys Configuration
# Note: Bun automatically loads .env files on startup.
# env is auto from provider, provider meta use META_API_KEY, custom use CUSTOM_API_KEY etc.
# ==========================================

# Meta AI API (https://api.meta.ai/v1)
# Models: muse-spark-1.2-contributor, muse-spark-1.2, muse-spark-1.1
META_API_KEY=your_meta_api_key_here

# SumoPod API (https://ai.sumopod.com/v1)
# Models: deepseek-v4-flash, qwen3.7-flash-2026-07-15, mimo-v2.5, gpt-5.6-luna
SUMOPOD_API_KEY=your_sumopod_api_key_here

# OpenRouter (https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API (https://api.openai.com/v1)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (https://api.anthropic.com/v1)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Default fallback API key for any custom/compatible endpoints
API_KEY=your_default_api_key_here
